generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// ═══════════════════════════════════════════════════════════════
// 1. universities Table
// ═══════════════════════════════════════════════════════════════
model University {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String       @unique @db.VarChar(255)
  logo_url   String?
  address    String?
  latitude   Float?
  longitude  Float?
  created_at DateTime     @default(now()) @db.Timestamptz

  users       User[]
  staff       Staff[]
  restaurants Restaurant[]
  orders      Order[]
  deans       Dean[]
  settings    UniversitySettings?
  preOrders   StaffPreOrder[]
  eventOrders EventPreOrder[]

  @@map("universities")
}

// ═══════════════════════════════════════════════════════════════
// 1.1. university_settings Table
// Stores per-university configuration including auto-rotating staff code
// ═══════════════════════════════════════════════════════════════
model UniversitySettings {
  id                          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  university_id               String   @unique @db.Uuid
  staff_access_code           String   @db.VarChar(20)       // Auto-rotated every 24 hours
  staff_code_rotated_at       DateTime @default(now()) @db.Timestamptz
  group_order_visible_students Boolean @default(false)       // Toggle for student group order access
  system_email                String?  @db.VarChar(255)      // Email used to send all system mails
  admin_email                 String?  @db.VarChar(255)      // Admin contact email
  super_admin_email           String?  @db.VarChar(255)      // Super admin contact email
  created_at                  DateTime @default(now()) @db.Timestamptz
  updated_at                  DateTime @default(now()) @updatedAt @db.Timestamptz

  university University @relation(fields: [university_id], references: [id])

  @@map("university_settings")
}

// ═══════════════════════════════════════════════════════════════
// 1.5. restaurants Table (Vendors/Stalls within University)
// ═══════════════════════════════════════════════════════════════
model Restaurant {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  university_id         String   @db.Uuid
  name                  String   @db.VarChar(100)
  logo_url              String?
  cover_url             String?
  rating                Float    @default(0.0)
  tags                  String[] @default([]) // e.g. ["Healthy", "Fast Food"]
  is_open               Boolean  @default(true)
  prep_time_minutes     Int      @default(15)
  is_event_restaurant   Boolean  @default(false) // Catering-only restaurant
  opening_time          DateTime? @db.Time       // Daily open time
  closing_time          DateTime? @db.Time       // Daily close time
  created_at            DateTime @default(now()) @db.Timestamptz

  university    University      @relation(fields: [university_id], references: [id])
  menuItems     MenuItem[]
  orders        Order[]
  staff         Staff[]
  preOrders     StaffPreOrder[]

  @@unique([university_id, name])
  @@map("restaurants")
}

// ═══════════════════════════════════════════════════════════════
// 2. users Table (Students & University Staff — app users)
// ═══════════════════════════════════════════════════════════════
enum UserType {
  student
  university_staff
}

model User {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  university_id  String   @db.Uuid
  name           String   @db.VarChar(100)
  phone          String   @unique @db.VarChar(15)
  email          String?  @unique @db.VarChar(255)
  user_type      UserType @default(student)
  wallet_balance Decimal  @default(0.00) @db.Decimal(10, 2)
  active_token   String?  @db.VarChar(64)
  created_at     DateTime @default(now()) @db.Timestamptz

  university      University         @relation(fields: [university_id], references: [id])
  groupOrders     GroupOrder[]
  groupMembers    GroupOrderMember[]
  orders          Order[]
  transactions    WalletTransaction[]
  reviews         Review[]
  preOrders       StaffPreOrder[]
  eventOrders     EventPreOrder[]
  redeemedCoupons DeanCoupon[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// 2.5 Wallet Transactions
// ═══════════════════════════════════════════════════════════════
enum TransactionType {
  credit
  debit
  refund
}

model WalletTransaction {
  id           String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String          @db.Uuid
  amount       Decimal         @db.Decimal(10, 2)
  type         TransactionType
  description  String          @db.VarChar(255)
  reference_id String?         @db.VarChar(255) // E.g., Razorpay payment_id or Order id
  created_at   DateTime        @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])

  @@map("wallet_transactions")
}

// ═══════════════════════════════════════════════════════════════
// 3. staff Table (Admin Panel + Counter Staff — NOT app users)
// ═══════════════════════════════════════════════════════════════
enum Role {
  staff
  admin
  super_admin
}

model Staff {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  university_id String   @db.Uuid
  restaurant_id String?  @db.Uuid   // NULL = all restaurants (admin), Non-null = locked to one (staff)
  email         String?  @unique @db.VarChar(255)
  password_hash String?  @db.VarChar(255)
  phone         String?  @unique @db.VarChar(15)
  name          String   @db.VarChar(100)
  role          Role
  permissions   Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz

  university    University  @relation(fields: [university_id], references: [id])
  restaurant    Restaurant? @relation(fields: [restaurant_id], references: [id])

  @@map("staff")
}

// ═══════════════════════════════════════════════════════════════
// 3.5 Deans — University deans managed by admin
// ═══════════════════════════════════════════════════════════════
model Dean {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  university_id   String   @db.Uuid
  name            String   @db.VarChar(100)
  email           String   @unique @db.VarChar(255)
  password_hash   String   @db.VarChar(255)
  school_name     String   @db.VarChar(255)
  total_budget    Decimal  @default(0.00) @db.Decimal(10, 2)
  used_budget     Decimal  @default(0.00) @db.Decimal(10, 2)
  active_token    String?  @db.VarChar(64)
  created_at      DateTime @default(now()) @db.Timestamptz

  university University   @relation(fields: [university_id], references: [id])
  coupons    DeanCoupon[]

  @@map("deans")
}

// ═══════════════════════════════════════════════════════════════
// 3.6 Dean Coupons — Budget distribution via coupon codes
// ═══════════════════════════════════════════════════════════════
enum CouponStatus {
  active
  redeemed
  expired
  revoked
}

model DeanCoupon {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dean_id     String       @db.Uuid
  code        String       @unique @db.VarChar(12)
  amount      Decimal      @db.Decimal(10, 2)
  status      CouponStatus @default(active)
  redeemed_by String?      @db.Uuid    // user_id of university_staff who redeemed
  event_name  String?      @db.VarChar(255)
  staff_email String?      @db.VarChar(255)  // Staff email the voucher was sent to
  redeemed_at DateTime?    @db.Timestamptz
  created_at  DateTime     @default(now()) @db.Timestamptz
  expires_at  DateTime     @db.Timestamptz  // Default: 30 days from creation

  dean Dean  @relation(fields: [dean_id], references: [id])
  user User? @relation(fields: [redeemed_by], references: [id])

  @@map("dean_coupons")
}

// ═══════════════════════════════════════════════════════════════
// 4. menu_items Table
// ═══════════════════════════════════════════════════════════════
model MenuItem {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  restaurant_id    String   @db.Uuid
  name             String   @db.VarChar(100)
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  category         String   @db.VarChar(50)
  image_url        String?
  is_available     Boolean  @default(true)
  stock_quantity   Int      @default(0)
  nutritional_info Json?
  created_at       DateTime @default(now()) @db.Timestamptz

  restaurant         Restaurant          @relation(fields: [restaurant_id], references: [id])
  orderItems         OrderItem[]
  reviews            Review[]
  preOrderItems      StaffPreOrderItem[]
  eventPreOrderItems EventPreOrderItem[]

  @@unique([restaurant_id, name])
  @@index([category])
  @@map("menu_items")
}

// ═══════════════════════════════════════════════════════════════
// 5. group_orders Table (Dutch Treat)
// ═══════════════════════════════════════════════════════════════
enum GroupOrderStatus {
  open
  locked
  paid
  completed
}

model GroupOrder {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code             String           @unique @db.VarChar(6)
  creator_id       String           @db.Uuid
  status           GroupOrderStatus
  split_mode       String           @default("individual") @db.VarChar(20)
  total_amount     Decimal          @default(0.00) @db.Decimal(10, 2)
  discount_applied Decimal          @default(0.00) @db.Decimal(10, 2)
  created_at       DateTime         @default(now()) @db.Timestamptz
  expires_at       DateTime?        @db.Timestamptz

  creator      User               @relation(fields: [creator_id], references: [id])
  members      GroupOrderMember[]
  orders       Order[] // Link if Group Order

  @@map("group_orders")
}

// ═══════════════════════════════════════════════════════════════
// 6. group_order_members Table
// ═══════════════════════════════════════════════════════════════
enum PaymentStatus {
  pending
  paid
  failed
}

model GroupOrderMember {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  group_order_id String        @db.Uuid
  user_id        String        @db.Uuid
  nickname       String?       @db.VarChar(30)
  share_amount   Decimal       @db.Decimal(10, 2)
  payment_status PaymentStatus
  payment_id     String?       @unique @db.VarChar(255)
  joined_at      DateTime      @default(now()) @db.Timestamptz

  groupOrder     GroupOrder    @relation(fields: [group_order_id], references: [id])
  user           User          @relation(fields: [user_id], references: [id])

  @@map("group_order_members")
}

// ═══════════════════════════════════════════════════════════════
// 7. orders Table
// ═══════════════════════════════════════════════════════════════
enum OrderStatus {
  pending
  preparing
  ready
  completed
  cancelled
}

enum OrderType {
  takeaway
  dine_in
  hostel_delivery
}

model Order {
  id               String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String      @db.Uuid
  university_id    String      @db.Uuid
  restaurant_id    String      @db.Uuid
  status           OrderStatus
  order_type       OrderType   @default(takeaway)
  total_amount     Decimal     @db.Decimal(10, 2)
  payment_id       String      @unique @db.VarChar(255)
  order_token      String?     @db.VarChar(10)
  qr_secret        String?     @db.VarChar(64)    // HMAC secret for rotating QR codes
  qr_rotated_at    DateTime?   @db.Timestamptz
  batch_id         String?     @db.VarChar(64)    // Groups sub-orders from a multi-restaurant checkout
  group_order_id   String?     @db.Uuid
  created_at       DateTime    @default(now()) @db.Timestamptz
  updated_at       DateTime    @default(now()) @updatedAt @db.Timestamptz

  user        User        @relation(fields: [user_id], references: [id])
  university  University  @relation(fields: [university_id], references: [id])
  restaurant  Restaurant  @relation(fields: [restaurant_id], references: [id])
  groupOrder  GroupOrder? @relation(fields: [group_order_id], references: [id])
  items       OrderItem[]

  @@map("orders")
}

// ═══════════════════════════════════════════════════════════════
// 8. order_items Table
// ═══════════════════════════════════════════════════════════════
model OrderItem {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id      String  @db.Uuid
  menu_item_id  String  @db.Uuid
  quantity      Int
  price_at_time Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [order_id], references: [id])
  menuItem MenuItem @relation(fields: [menu_item_id], references: [id])

  @@map("order_items")
}

// ═══════════════════════════════════════════════════════════════
// 9. reviews Table
// ═══════════════════════════════════════════════════════════════
model Review {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String   @db.Uuid
  menu_item_id String   @db.Uuid
  rating       Int      // 1-5 stars
  created_at   DateTime @default(now()) @db.Timestamptz

  user     User     @relation(fields: [user_id], references: [id])
  menuItem MenuItem @relation(fields: [menu_item_id], references: [id])

  @@unique([user_id, menu_item_id])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════
// 10. Staff Pre-Orders (Daily meal pre-ordering for university staff)
// ═══════════════════════════════════════════════════════════════
enum PreOrderStatus {
  pending
  confirmed
  preparing
  ready
  completed
  cancelled
}

model StaffPreOrder {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String         @db.Uuid
  university_id   String         @db.Uuid
  restaurant_id   String         @db.Uuid
  status          PreOrderStatus @default(pending)
  order_date      DateTime       @db.Date              // The date for which food is pre-ordered
  total_amount    Decimal        @db.Decimal(10, 2)
  payment_method  String         @default("wallet") @db.VarChar(20)
  created_at      DateTime       @default(now()) @db.Timestamptz

  user       User                @relation(fields: [user_id], references: [id])
  university University          @relation(fields: [university_id], references: [id])
  restaurant Restaurant          @relation(fields: [restaurant_id], references: [id])
  items      StaffPreOrderItem[]

  @@map("staff_pre_orders")
}

model StaffPreOrderItem {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pre_order_id    String  @db.Uuid
  menu_item_id    String  @db.Uuid
  quantity        Int
  price_at_time   Decimal @db.Decimal(10, 2)

  preOrder StaffPreOrder @relation(fields: [pre_order_id], references: [id])
  menuItem MenuItem      @relation(fields: [menu_item_id], references: [id])

  @@map("staff_pre_order_items")
}

// ═══════════════════════════════════════════════════════════════
// 11. Event Pre-Orders (Staff event catering requests)
// ═══════════════════════════════════════════════════════════════
enum EventStatus {
  upcoming
  pending
  approved
  confirmed
  preparing
  completed
  cancelled
  rejected
}

model EventPreOrder {
  id               String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String      @db.Uuid         // The staff member who created it
  university_id    String      @db.Uuid
  event_name       String      @db.VarChar(255)
  event_date       DateTime    @db.Date
  event_time       String      @db.VarChar(10)  // HH:MM format
  member_count     Int
  staff_name       String      @db.VarChar(100)
  staff_email      String      @db.VarChar(255)
  status           EventStatus @default(upcoming)
  total_amount     Decimal     @default(0.00) @db.Decimal(10, 2)
  rejection_reason String?                    // Reason for rejection by admin
  created_at       DateTime    @default(now()) @db.Timestamptz

  user       User                @relation(fields: [user_id], references: [id])
  university University          @relation(fields: [university_id], references: [id])
  items      EventPreOrderItem[]

  @@map("event_pre_orders")
}

model EventPreOrderItem {
  id               String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_order_id   String  @db.Uuid
  menu_item_id     String  @db.Uuid
  quantity         Int
  price_at_time    Decimal @db.Decimal(10, 2)

  eventOrder EventPreOrder @relation(fields: [event_order_id], references: [id])
  menuItem   MenuItem      @relation(fields: [menu_item_id], references: [id])

  @@map("event_pre_order_items")
}
